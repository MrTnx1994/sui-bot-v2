# sub-UI (install.sh substitutes domain/cert/port):
#   everything proxies to our subpage service (127.0.0.1:8099) which serves
#   the browser subscription UI and raw config feeds for VPN-app user agents.
#   The s-ui panel ports (2095/2096/2097) are never touched.
server {
    listen __UI_PORT__ ssl;
    server_name __DOMAIN__;

    ssl_certificate __CERT__;
    ssl_certificate_key __CERTKEY__;

    # subscription pages (+ raw feed for VPN-app UAs)
    location /sub/ {
        proxy_pass http://127.0.0.1:8099;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # root → short guide page
    location = / {
        return 200 '<!DOCTYPE html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>اشتراک Vpnfiy</title></head><body style="font-family:Tahoma;background:#0f172a;color:#e2e8f0;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0"><div style="text-align:center"><div style="font-size:44px">⚡</div><h2 style="margin:10px 0">اشتراک Vpnfiy</h2><p style="color:#94a3b8;font-size:14px">لینک اشتراک شما:<br><code style="color:#7dd3fc">https://__DOMAIN__:__UI_PORT__/sub/نام-شما</code></p></div></body></html>';
        default_type text/html;
    }
}
