# =====================================================================
# SUI Bot — نمونهٔ تنظیمات  (کپی کن به /etc/sui-bot/sui-bot.env و پر کن)
#   cp sui-bot.env.sample /etc/sui-bot/sui-bot.env && nano /etc/sui-bot/sui-bot.env
# =====================================================================

# --- ضروری ---
SUI_HOST=https://panel.example.com:2095/app
SUI_TOKEN=replace-me
BOT_TOKEN=replace-me
ADMIN_TELEGRAM_ID=replace-me

# --- امنیت ---
# فقط وقتی پنل HTTPS معتبر ندارد و به آن اعتماد داری true کن
ALLOW_INSECURE_HTTP=false

# --- هویت و نمایش ---
BOT_DISPLAY_NAME="Vpnfiy"
ADMIN_IDS=
PAYMENT_CARD_NUMBER=0000-0000-0000-0000
PAYMENT_CARD_HOLDER=

# --- فروشگاه (کارت‌به‌کارت + درگاه + کیف پول + تخفیف + تست) ---
STORE_ENABLED=true
STORE_DATA_DIR=store_data/shop_orders.json

# --- درگاه زرین‌پال (خالی = فقط کارت‌به‌کارت) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_MIN_TOMAN=50000
ZARINPAL_CALLBACK_BASE=
ZARINPAL_CALLBACK_BIND=127.0.0.1
ZARINPAL_CALLBACK_PORT=8098

# --- اکانت تست رایگان (۵۰۰MB/۱روز) ---
TRIAL_ENABLED=true
TRIAL_INBOUND_ID=0

# --- سرویس صفحهٔ اشتراک/منو ---
SUBPAGE_PORT=8099
SUBPAGE_BIND=127.0.0.1
SUB_BASE_URL_OVERRIDE=

# --- لاگ ---
BOT_LOG_FILE=
DATA_DIR=/var/lib/sui-bot
